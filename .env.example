# Copy to .env before deploying. The service port is fixed at 5522.
BIND_HOST=0.0.0.0
GPU_DEVICE_ID=0
# Host bind directory. Relative paths are resolved from this repository.
CMYK_API_OUTPUT_DIR=./output
CMYK_API_MAX_UPLOAD_GIB=64
CMYK_API_MAX_CSV_MIB=64
CMYK_API_MAX_IMAGE_MIB=512
CMYK_API_MAX_IMAGE_PIXELS=268435456
CMYK_API_UPLOAD_CHUNK_MIB=8
CMYK_API_MAX_PENDING_JOBS=4
CMYK_API_JOB_TTL_HOURS=24
CMYK_API_CLEANUP_INTERVAL_SECONDS=3600
CMYK_API_CACHE_TTL_HOURS=24
CMYK_PDF_NATIVE_MAX_PIXELS=64000000
CMYK_PDF_PARSE_MAX_TOKENS=20000000
